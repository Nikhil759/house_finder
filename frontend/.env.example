# Leave blank for local dev — Vite proxy handles it automatically
# Set to your Railway/Render backend URL for production
VITE_API_URL=

# PostHog project API key (public; safe in client bundle)
VITE_PUBLIC_POSTHOG_KEY=

# Encore Wav partner branding (optional override)
VITE_ENCORE_WAV_URL=https://www.encorewav.com/
