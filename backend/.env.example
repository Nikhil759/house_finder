# ── Database (Supabase Postgres) ──────────────────────────────────────────────
# Direct connection (for migrations, GHA ingestion jobs):
SUPABASE_DB_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
# Pooled connection (for the Flask app — supports many short-lived connections):
SUPABASE_DB_URL_POOLER=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Legacy — kept for backward compatibility during migration. Remove once cutover is complete.
DATABASE_URL=

# ── Reddit OAuth API ──────────────────────────────────────────────────────────
# Create an app at https://www.reddit.com/prefs/apps (type: script)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ── Telegram MTProto API ───────────────────────────────────────────────────────
# Obtain from https://my.telegram.org → API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Name of the local .session file (no extension). Defaults to "housing_finder".
TELEGRAM_SESSION_NAME=housing_finder
# Generated once locally via the generate_session.py script.
# Set this in GHA secrets instead of using a .session file.
TELEGRAM_SESSION_STRING=

# ── Email alerts (Resend) ──────────────────────────────────────────────────────
# Obtain from https://resend.com/api-keys
RESEND_API_KEY=
# Verified sender address configured in your Resend domain settings.
RESEND_FROM_EMAIL=alerts@nestiq.homes
# Reply-to address shown in email clients.
RESEND_REPLY_TO=hello@nestiq.homes
# Resend webhook signing secret (from Resend dashboard → Webhooks → Signing secret).
RESEND_WEBHOOK_SECRET=

# ── Email action tokens ──────────────────────────────────────────────────────
# Secret used to sign one-click email action URLs (unsubscribe, frequency change).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
EMAIL_ACTION_SECRET=

# ── PostHog (server-side capture) ────────────────────────────────────────────
# Project API key for server-side event capture.
# This is the *public* project key (phc_...), NOT the personal API key.
POSTHOG_PROJECT_API_KEY=

# ── App URLs ─────────────────────────────────────────────────────────────────
# Public frontend URL (used in email links). Defaults to https://nestiq.homes.
APP_URL=https://nestiq.homes
# Public API URL (used in email action links). Defaults to APP_URL.
API_URL=

# ── NewsAPI ────────────────────────────────────────────────────────────────────
# Obtain from https://newsapi.org/account
NEWS_API_KEY=

# ── Gemini (Google AI Studio) ──────────────────────────────────────────────────
# Obtain from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── Google Places API ───────────────────────────────────────────────────────────
# Obtain from https://console.cloud.google.com/apis (enable "Places API")
# Used by scripts/enrich_society_images.py and scripts/enrich_societies_from_places.py
# to geocode societies and fetch exterior photos (Text Search + Photo endpoints).
GOOGLE_PLACES_API_KEY=

# ── Flask server ───────────────────────────────────────────────────────────────
PORT=5001
FLASK_DEBUG=false
